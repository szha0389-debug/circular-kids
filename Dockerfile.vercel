FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=80

WORKDIR /app

COPY backend/requirements-inference.txt /tmp/requirements-inference.txt
RUN python -m pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cpu \
      torch==2.13.0 torchvision==0.28.0 \
    && python -m pip install --no-cache-dir -r /tmp/requirements-inference.txt

COPY backend /app/backend
COPY training/pytorch_model.py training/classes.json /app/training/
COPY training/artifacts/best_model.pth /app/training/artifacts/best_model.pth

CMD ["sh", "-c", "exec uvicorn backend.ai_server:app --host 0.0.0.0 --port ${PORT:-80}"]
