FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AI_DEVICE=cpu \
    PORT=8000

WORKDIR /app

COPY backend/requirements-inference.txt /tmp/requirements-inference.txt
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r /tmp/requirements-inference.txt

COPY backend/ai_server.py /app/backend/ai_server.py
COPY training/pytorch_model.py /app/training/pytorch_model.py
COPY training/classes.json /app/training/classes.json
COPY training/artifacts/best_model.pth /app/training/artifacts/best_model.pth

EXPOSE 8000

CMD ["sh", "-c", "python -m uvicorn backend.ai_server:app --host 0.0.0.0 --port ${PORT}"]
